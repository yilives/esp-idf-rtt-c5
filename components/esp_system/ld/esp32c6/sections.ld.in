/* Default entry point */
ENTRY(call_start_cpu0);

SECTIONS
{
#include "ld.rtc.sections"

#include "ld.iram.sections"

#include "ld.dram.sections"

#if CONFIG_IDF_RTOS_RTTHREAD
  /* Use 16-byte alignment for the RISC-V stack ABI and RT-Thread RT_ALIGN_SIZE. */
  /* RT-Thread interrupt stack: vectors.S switches to it via __stack_end__ */
  .stack :
  {
      . = ALIGN(16);
      __STACKSIZE__ = CONFIG_IDF_RTTHREAD_INTERRUPT_STACK_SIZE;
      __stack_start__ = .;
      *(.stack*)
      . = ALIGN(16);
      . += __STACKSIZE__;
      __stack_cpu0 = .;
      __stack_end__ = .;
  } > dram_seg
  PROVIDE( __rt_rvstack = __stack_end__);

  /* RT-Thread heap */
  .heap :
  {
      . = ALIGN(16);
      __HEAPSIZE__ = CONFIG_IDF_RTTHREAD_HEAP_SIZE;
      __heap_start__ = .;
      . += __HEAPSIZE__;
      __heap_end__ = .;
  } > dram_seg
#endif

#include "ld.flash.sections"

/* RT-Thread's finsh symbol table and auto-init callbacks now live inside
   .flash.rodata - see ld.flash.sections. A standalone section here would
   be a third loadable segment, which SOC_MMU_DI_VADDR_SHARED chips cannot
   map (bootloader_utility.c:833 asserts rom_index < 2). */

#include "ld.heap.sections"

#include "ld.debug.sections"
#include "ld.discard.sections"
}
